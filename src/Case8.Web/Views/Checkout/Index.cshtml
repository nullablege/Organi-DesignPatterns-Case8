@model Case8.Web.Models.CheckoutViewModel
@{ ViewData["Title"] = "Checkout"; }
<section class="breadcrumb_section text-center" style="background-image: url('/assets/images/breadcrumb/breadcrumb1.png')"><div class="container"><h1 class="page_title">Checkout</h1><ul class="breadcrumb_nav ul_li justify-content-center"><li><a asp-controller="Cart" asp-action="Index">Cart</a></li><li>Checkout</li></ul></div></section>
<section class="checkout_section sec_space_large"><div class="container">@if (Model.ValidationError is not null) { <div class="alert alert-danger">@Model.ValidationError</div> }<div class="row g-5"><div class="col-lg-7"><div class="checkout_form"><h3 class="form_title">Choose shipping</h3><form method="get">@foreach (var method in Model.Methods) { <label class="checkout_shipping_option d-flex align-items-center mb-3 p-4"><input class="me-3" type="radio" name="method" value="@method" checked="@(method == Model.SelectedMethod)" onchange="this.form.submit()" /><span><strong>@(method == "pickup" ? "Store Pickup" : char.ToUpper(method[0]) + method[1..])</strong><small class="d-block">Calculated by the selected shipping strategy.</small></span></label> }</form></div></div><div class="col-lg-5"><div class="cart_pricing_table text-uppercase"><h3 class="table_title text-center">Order summary</h3><ul class="ul_li_block clearfix"><li><span>Products</span><span>₺@Model.Cart.Total.ToString("N2")</span></li><li><span>Shipping</span><span>₺@Model.ShippingCost.ToString("N2")</span></li><li><span>Total</span><span>₺@((Model.Cart.Total + Model.ShippingCost).ToString("N2"))</span></li></ul>@if (Model.ValidationError is null) { <div class="btn_wrap pt-0 text-center"><form asp-action="PlaceOrder" method="post"><input type="hidden" name="method" value="@Model.SelectedMethod" /><button class="btn text-uppercase text-white rounded-pill" type="submit">Place order</button></form></div> }</div></div></div></div></section>
