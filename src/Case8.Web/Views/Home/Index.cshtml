@model Case8.Web.Models.HomeViewModel
@{ ViewData["Title"] = "Home"; }
<section class="banner_section_main position-relative banner_2"><div class="banner_section_item d-flex justify-content-center align-items-center sec_space_large" style="background-image: url('/assets/images/banner/banner2.png')"><div class="container"><div class="row"><div class="col-lg-7 ms-3"><div class="banner_sub_title2 position-relative"><h6 class="text-white text-uppercase position-absolute">100% Organic Foods</h6><img class="sub_title_bg" src="~/assets/images/shapes/shape2.png" alt="" /></div><div class="banner_title2"><h1>Fresh food for your table <span class="text-effect">every day</span></h1></div><div class="banner_desc py-3"><p>Thoughtfully selected organic products, delivered from farm to kitchen.</p></div><a class="btn custom_btn rounded-pill px-5 py-3 text-white" asp-controller="Shop" asp-action="Index">Shop now <i class="fas fa-long-arrow-alt-right"></i></a></div></div></div></div><img class="banner2_right_thumb position-absolute" src="~/assets/images/shapes/shape5.png" alt="" /></section>
<section class="service_setion2"><div class="service_content_wrap2"><div class="container"><div class="row services2_content"><div class="col-6 col-lg-3"><div class="service_inner_content d-flex align-items-center"><div class="service_content_icon rounded-pill me-3"><img src="~/assets/images/services/service1.png" alt="" /></div><h6 class="service_content_title">Organic farm products</h6></div></div><div class="col-6 col-lg-3"><div class="service_inner_content d-flex align-items-center"><div class="service_content_icon rounded-pill me-3"><img src="~/assets/images/services/service2.png" alt="" /></div><h6 class="service_content_title">Fresh home delivery</h6></div></div><div class="col-6 col-lg-3"><div class="service_inner_content d-flex align-items-center"><div class="service_content_icon rounded-pill me-3"><img src="~/assets/images/services/service3.png" alt="" /></div><h6 class="service_content_title">Weekly promotions</h6></div></div><div class="col-6 col-lg-3"><div class="service_inner_content d-flex align-items-center"><div class="service_content_icon rounded-pill me-3"><img src="~/assets/images/services/service4.png" alt="" /></div><h6 class="service_content_title">Seasonal selections</h6></div></div></div></div></div></section>
<section class="category_section sec_space_large"><div class="container"><div class="section_title text-center mb-5"><div class="sub_title d-flex justify-content-center align-items-center"><i class="fas fa-leaf"></i><span>SHOP BY CATEGORY</span><i class="fas fa-leaf"></i></div><h2 class="title_text">Browse our categories</h2></div><div class="row g-4 justify-content-center">@{ var imageIndex = 1; } @foreach (var category in Model.Categories) { <div class="col-md-4"><a class="category_layout_1 text-center d-block" asp-controller="Shop" asp-action="Index" asp-route-categoryId="@category.Id"><span class="category_image rounded-circle d-inline-flex align-items-center justify-content-center"><img src="~/assets/images/category/ctg_icon@(imageIndex).png" alt="@category.Name" /></span><h3 class="category_title mt-3">@category.Name</h3></a></div> imageIndex++; }</div></div></section>
<section class="product_section home2_product_sec sec_space_large"><div class="container"><div class="section_title text-center mb-5"><div class="sub_title d-flex justify-content-center align-items-center"><i class="fas fa-leaf"></i><span>OUR STORE</span><i class="fas fa-leaf"></i></div><h2 class="title_text">Featured products</h2></div><partial name="_ProductGrid" model="Model.Products" /></div></section>
