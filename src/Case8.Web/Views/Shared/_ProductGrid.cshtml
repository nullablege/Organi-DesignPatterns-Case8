@model IReadOnlyList<Case8.Application.ProductListItem>
<div class="row g-4">
@foreach (var product in Model)
{
    <div class="col-sm-6 col-lg-4"><article class="product_layout_1 overflow-hidden position-relative h-100"><div class="product_layout_content bg-white position-relative h-100"><div class="product_image_wrap"><a class="product_image d-flex justify-content-center align-items-center" asp-controller="Shop" asp-action="Detail" asp-route-id="@product.Id"><img src="@(product.ImageUrl ?? "/assets/images/product/product1.png")" alt="@product.Name" /></a><ul class="product_badge_group ul_li_block"><li><span class="product_badge badge_fruits position-absolute rounded-pill text-uppercase">@product.CategoryName</span></li></ul>@if (product.Stock > 0) { <form asp-controller="Cart" asp-action="Add" method="post" class="product_action_btns ul_li_block d-flex"><input type="hidden" name="productId" value="@product.Id" /><input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" /><li><button class="tooltips border-0" title="Add To Cart" aria-label="Add @product.Name to cart"><i class="fas fa-shopping-bag"></i></button></li></form> }</div><div class="rating_wrap d-flex"><ul class="rating_star ul_li"><li class="active"><i class="fas fa-star"></i></li><li class="active"><i class="fas fa-star"></i></li><li class="active"><i class="fas fa-star"></i></li><li class="active"><i class="fas fa-star"></i></li><li><i class="far fa-star"></i></li></ul><span class="shop_review_text">( 4.0 )</span></div><div class="product_content"><h3 class="product_title"><a asp-controller="Shop" asp-action="Detail" asp-route-id="@product.Id">@product.Name</a></h3><div class="product_price"><span class="sale_price">₺@product.Price.ToString("N2")</span></div>@if (product.Stock == 0) { <span class="text-danger small">Out of stock</span> }</div></div></article></div>
}
</div>
