@model Case8.Application.CartSummary
@{ ViewData["Title"] = "Cart"; }
<section class="breadcrumb_section text-center" style="background-image: url('/assets/images/breadcrumb/breadcrumb1.png')"><div class="container"><h1 class="page_title">Cart</h1><ul class="breadcrumb_nav ul_li justify-content-center"><li><a asp-controller="Home" asp-action="Index">Home</a></li><li>Cart</li></ul></div></section>
<section class="cart_section sec_space_large"><div class="container">@if (!Model.Items.Any()) { <div class="text-center py-5"><i class="fas fa-shopping-bag fa-3x text-success mb-4"></i><h2>Your cart is empty</h2><a class="btn custom_btn rounded-pill px-5 py-3 text-white mt-3" asp-controller="Shop" asp-action="Index">Continue shopping</a></div> } else { <div class="cart_table"><table class="table align-middle"><thead><tr><th>Product</th><th>Price</th><th>Quantity</th><th>Total</th><th></th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td><div class="d-flex align-items-center"><img class="cart_product_thumb me-3" src="@(item.ImageUrl ?? "/assets/images/product/product1.png")" alt="@item.Name" /><strong>@item.Name</strong></div></td><td>₺@item.UnitPrice.ToString("N2")</td><td><form asp-action="Update" method="post" class="d-flex align-items-center"><input type="hidden" name="productId" value="@item.ProductId" /><div class="quantity_input"><input class="input_number" type="number" name="quantity" min="1" max="@item.Stock" value="@item.Quantity" aria-label="Quantity for @item.Name" /></div><button class="btn btn-link text-success ms-2" type="submit">Update</button></form></td><td>₺@((item.UnitPrice * item.Quantity).ToString("N2"))</td><td><form asp-action="Remove" method="post"><input type="hidden" name="productId" value="@item.ProductId" /><button class="btn btn-link text-danger" type="submit" aria-label="Remove @item.Name"><i class="fas fa-times"></i></button></form></td></tr> }</tbody></table></div><div class="row justify-content-lg-end"><div class="col-lg-4 mt-5"><div class="cart_pricing_table text-uppercase"><h3 class="table_title text-center">Cart total</h3><ul class="ul_li_block clearfix"><li><span>Subtotal</span><span>₺@Model.Total.ToString("N2")</span></li><li><span>Total</span><span>₺@Model.Total.ToString("N2")</span></li></ul><div class="btn_wrap pt-0 text-center"><a class="btn text-uppercase text-white rounded-pill" asp-controller="Checkout" asp-action="Index">Proceed to checkout</a></div></div></div></div> }</div></section>
