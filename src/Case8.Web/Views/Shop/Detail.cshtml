@model Case8.Application.ProductDetail
@{ ViewData["Title"] = Model.Name; }
<section class="breadcrumb_section text-center" style="background-image: url('/assets/images/breadcrumb/breadcrumb1.png')"><div class="container"><h1 class="page_title">Product detail</h1><ul class="breadcrumb_nav ul_li justify-content-center"><li><a asp-controller="Home" asp-action="Index">Home</a></li><li><a asp-controller="Shop" asp-action="Index">Shop</a></li><li>@Model.Name</li></ul></div></section>
<section class="product_section sec_space_large"><div class="container"><div class="row g-5 align-items-center"><div class="col-lg-6"><div class="product_detail_image text-center" style="background-image: url('/assets/images/backgrounds/bg17.png')"><img class="img-fluid" src="@(Model.ImageUrl ?? "/assets/images/product/product1.png")" alt="@Model.Name" /></div></div><div class="col-lg-6"><div class="rating_wrap d-flex justify-content-between"><div class="rating_review_cont d-flex align-items-center"><ul class="rating_star ul_li"><li class="active"><i class="fas fa-star"></i></li><li class="active"><i class="fas fa-star"></i></li><li class="active"><i class="fas fa-star"></i></li><li class="active"><i class="fas fa-star"></i></li><li><i class="far fa-star"></i></li></ul><span class="review">Fresh selection</span></div><span class="btn custom_btn rounded-pill px-4 text-white">@Model.CategoryName</span></div><h2 class="product_detail_title">@Model.Name</h2><p class="product_detail_desc py-2">@Model.Description</p><div class="product_price mb-4"><span class="sale_price">₺@Model.Price.ToString("N2")</span></div>@if (Model.Stock > 0) { <p class="text-success mb-4">@Model.Stock items in stock</p><form asp-controller="Cart" asp-action="Add" method="post" class="product10_quantity_btn_wrap d-flex align-items-center"><input type="hidden" name="productId" value="@Model.Id" /><input type="hidden" name="returnUrl" value="@Context.Request.Path" /><div class="quantity_input"><input class="input_number" type="number" min="1" max="@Model.Stock" name="quantity" value="1" aria-label="Quantity" /></div><button class="btn custom_btn rounded-pill ms-3 px-5 py-3 text-white" type="submit">Add to cart <i class="fas fa-shopping-bag"></i></button></form> } else { <p class="text-danger">Out of stock</p> }<div class="product_tags_wrap d-flex align-items-center mt-5"><h6 class="product_tags_title text-uppercase">category:</h6><div class="tags_item"><a asp-controller="Shop" asp-action="Index">@Model.CategoryName</a></div></div></div></div></div></section>
