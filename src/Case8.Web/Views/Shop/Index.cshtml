@model Case8.Web.Models.ShopViewModel
@{ ViewData["Title"] = "Shop"; var pageCount = (int)Math.Ceiling((double)Model.Result.TotalCount / Model.Result.PageSize); }
<section class="breadcrumb_section text-center" style="background-image: url('/assets/images/breadcrumb/breadcrumb1.png')"><div class="container"><h1 class="page_title">Shop list sidebar</h1><ul class="breadcrumb_nav ul_li justify-content-center"><li><a asp-controller="Home" asp-action="Index">Home</a></li><li>Shop</li></ul></div></section>
<section class="shop_section sec_space_large"><div class="container"><div class="row g-5"><aside class="col-lg-3"><div class="sidebar_widget"><h3 class="sidebar_widget_title">Search products</h3><form method="get" class="sidebar_widget_search"><input name="search" value="@Model.Search" placeholder="Search products" /><button aria-label="Search"><i class="fas fa-search"></i></button><div class="pt-4"><h3 class="sidebar_widget_title">Categories</h3><select class="form-select mb-3" name="categoryId"><option value="">All categories</option>@foreach (var category in Model.Result.Categories) { <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option> }</select><h3 class="sidebar_widget_title">Sort by</h3><select class="form-select mb-3" name="sort"><option value="">Name</option><option value="price_asc" selected="@(Model.Sort == "price_asc")">Price: low to high</option><option value="price_desc" selected="@(Model.Sort == "price_desc")">Price: high to low</option></select><button class="btn custom_btn rounded-pill text-white px-4" type="submit">Apply</button></div></form></div></aside><div class="col-lg-9"><div class="shop_topbar d-flex justify-content-between align-items-center mb-4"><p class="mb-0">Showing @Model.Result.TotalCount products</p><span><i class="fas fa-th-large"></i> Organic market</span></div><partial name="_ProductGrid" model="Model.Result.Products" />@if (pageCount > 1) { <ul class="pagination_wrap ul_li justify-content-center mt-5">@for (var p = 1; p <= pageCount; p++) { <li class="@(p == Model.Result.Page ? "active" : "")"><a asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-sort="@Model.Sort" asp-route-page="@p">@p</a></li> }</ul> }</div></div></div></section>
