@model IReadOnlyList<Product>
@{ ViewData["Title"] = "Admin"; }
<div class="container py-5"><div class="d-flex justify-content-between"><h1>Admin panel</h1><div><a class="btn btn-outline-success" asp-controller="Categories" asp-action="Index">Categories</a><a class="btn btn-outline-success" asp-controller="Orders" asp-action="Index">Orders</a><a class="btn btn-outline-success" asp-controller="Activity" asp-action="Index">Activity</a><a class="btn btn-success" asp-controller="Products" asp-action="Index">Products</a></div></div><p class="text-muted mt-3">Manage products, stock and order transitions.</p><table class="table"><thead><tr><th>Product</th><th>Stock</th><th>Status</th></tr></thead><tbody>@foreach(var product in Model){<tr><td>@product.Name</td><td>@product.Stock</td><td>@(product.IsActive ? "Active" : "Inactive")</td></tr>}</tbody></table></div>
