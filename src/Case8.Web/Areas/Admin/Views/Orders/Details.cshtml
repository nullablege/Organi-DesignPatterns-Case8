@model Order
@{ ViewData["Title"] = $"Order #{Model.Id}"; }
<div class="container py-5"><h1>Order #@Model.Id</h1>@if (TempData["Message"] is string message) { <div class="alert alert-success">@message</div> }@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }<p><strong>Status:</strong> @Model.Status</p><p><strong>Shipping:</strong> @Model.ShippingMethod · ₺@Model.ShippingCost.ToString("N2")</p><table class="table"><thead><tr><th>Product</th><th>Quantity</th><th>Unit price</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.ProductName</td><td>@item.Quantity</td><td>₺@item.UnitPrice.ToString("N2")</td></tr> }</tbody></table><div class="d-flex gap-2">@foreach (var command in new[] { "prepare", "ship", "deliver", "cancel" }) { <form asp-action="Transition" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="command" value="@command"/><button class="btn btn-outline-success">@command</button></form> }</div></div>
