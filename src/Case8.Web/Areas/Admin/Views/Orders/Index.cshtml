@model IReadOnlyList<Order>
@{ ViewData["Title"] = "Orders"; }
<div class="container py-5"><h1>Orders</h1><table class="table mt-3"><thead><tr><th>#</th><th>Date</th><th>Status</th><th>Total</th><th></th></tr></thead><tbody>@foreach (var order in Model) { <tr><td>@order.Id</td><td>@order.CreatedAt.ToLocalTime().ToString("g")</td><td>@order.Status</td><td>₺@order.Total.ToString("N2")</td><td><a asp-action="Details" asp-route-id="@order.Id">Details</a></td></tr> }</tbody></table></div>
